# Copy to .env.local for local work. All values are public (they end up in the browser).

# Cloudflare Web Analytics token (cookieless). Leave empty to disable analytics.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# The app that receives pilot sign-ups. Production: https://app.quotebird.ai
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Cloudflare Turnstile site key. 1x00000000000000000000AA is Cloudflare's always-pass test key.
# Production: the real key from the Cloudflare account.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
